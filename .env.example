# انسخ هذا الملف إلى .env واملأ القيم
# ملاحظة: Vite يستبدل هذه القيم وقت البناء (build)، لذا يجب أن تكون موجودة قبل تشغيل npm run build
# وعلى منصة النشر (Vercel وغيرها) أضِفها في Environment Variables ثم أعد النشر.

# رابط مشروع Supabase — مثال: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# مفتاح Supabase العام (anon / publishable)
VITE_SUPABASE_ANON_KEY=

# رابط الـ API الأساسي
VITE_API_BASE_URL=

# مفتاح Stripe العام (publishable)
VITE_STRIPE_PUBLISHABLE_KEY=
