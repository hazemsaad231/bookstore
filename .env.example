# Copy this file to .env and fill in the values.
# Note: Vite inlines these values at build time, so they must exist before running `npm run build`.
# On the hosting platform (Vercel, Netlify, ...) add them under Environment Variables and redeploy.

# Supabase project URL — e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase public key (anon / publishable)
VITE_SUPABASE_ANON_KEY=

# Base URL of the books/orders API
VITE_API_BASE_URL=

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=
